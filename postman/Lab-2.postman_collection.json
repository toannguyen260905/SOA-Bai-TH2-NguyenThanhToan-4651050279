{
  "info": {
    "name": "BTH 2 - Express Router Middleware JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Login saves token and logs decoded header/payload in Postman Console."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "userName",
      "value": "student",
      "type": "string"
    },
    {
      "key": "passwordPlain",
      "value": "Student@123",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"{{passwordBase64}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const password = pm.collectionVariables.get('passwordPlain');",
              "pm.variables.set('passwordBase64', require('buffer').Buffer.from(password, 'utf8').toString('base64'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const token = pm.response.json().token;",
              "  pm.collectionVariables.set('token', token);",
              "  const decode = part => JSON.parse(require('buffer').Buffer.from(part.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'));",
              "  console.log('JWT header', decode(token.split('.')[0]));",
              "  console.log('JWT payload', decode(token.split('.')[1]));",
              "  pm.test('JWT has 3 parts and fits VARCHAR(255)', () => { pm.expect(token.split('.')).to.have.lengthOf(3); pm.expect(token.length).to.be.at.most(255); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Authenticate",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct user', () => pm.expect(pm.response.json().user.userName).to.eql(pm.collectionVariables.get('userName'))); "
            ]
          }
        }
      ]
    },
    {
      "name": "03 Hello World",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Hello World response', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Invalid token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid.jwt.token",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"password\": \"d3Jvbmc=\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Missing fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}